# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` -- it is git-ignored. This example holds placeholders only.

APP_NAME="HireFlow AI"
APP_ENV=development
DEBUG=true

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hireflow
POSTGRES_USER=hireflow_user
POSTGRES_PASSWORD=change-me

# Auth (used from Phase 3). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
