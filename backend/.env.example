# Copy this file to `.env` and fill in real values (or run `python scripts/setup_db.py`,
# which generates them for you). NEVER commit `.env` -- it is git-ignored.
# This example holds placeholders only.

APP_NAME="HireFlow AI"
# "development" locally. Anything else (e.g. "production") enforces secure cookies and
# refuses to start without a strong SECRET_KEY.
APP_ENV=development
DEBUG=true

# Frontend origins allowed to call the API (comma-separated, exact match, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hireflow
POSTGRES_USER=hireflow_user
POSTGRES_PASSWORD=change-me

# --- Authentication ---
# Signs access tokens. 32+ characters, random, secret. Rotating it signs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_DAYS=30

# Refresh-token cookie. Leave COOKIE_SECURE unset: it is automatically true unless
# APP_ENV=development. COOKIE_SAMESITE: strict (default), lax, or none (needs HTTPS).
# COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Failed-login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_IP_MAX_FAILED_ATTEMPTS=30
LOGIN_LOCKOUT_MINUTES=15
